# Contract tests read MIDWATER_API_KEY and MIDWATER_BASE_URL from the environment only.
# Copy to .env.contract (git-ignored) if you like, then export the two values before running
# `pytest -m contract`. The base URL must be localhost.
MIDWATER_BASE_URL=http://localhost:3200
MIDWATER_API_KEY=mw_test_replace_with_a_test_key
